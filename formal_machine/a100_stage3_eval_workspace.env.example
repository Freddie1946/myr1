# Non-secret, user-owned workspace paths for the eight-A100 Stage 3/evaluation machine.
# Copy outside Git to:
#   /home/dataset-assist-0/czy/wjy/a100_stage3_eval_workspace.env
#
# Never add API keys, Hugging Face tokens or judge credentials to this file.

export PATHVLM_WORKSPACE_ROOT="/home/dataset-assist-0/czy/wjy"
export PATHVLM_REPO_ROOT="$PATHVLM_WORKSPACE_ROOT/myr1"
export PATHVLM_INSTALL_ROOT="$PATHVLM_WORKSPACE_ROOT/pathvlm_r1_v1_a100"
export PATHVLM_EVAL_ROOT="$PATHVLM_WORKSPACE_ROOT/pathvlm_revision_eval_a100"

# Isolated Codex installation and state.
export CODEX_HOME="$PATHVLM_WORKSPACE_ROOT/.codex-wjy"
export CODEX_INSTALL_DIR="$PATHVLM_WORKSPACE_ROOT/codex-bin"
export PATH="$CODEX_INSTALL_DIR:$PATH"

# Keep model/data/package caches under the user's workspace.
export HF_HOME="$PATHVLM_WORKSPACE_ROOT/cache/huggingface"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export CONDA_PKGS_DIRS="$PATHVLM_WORKSPACE_ROOT/cache/conda-pkgs"
export PIP_CACHE_DIR="$PATHVLM_WORKSPACE_ROOT/cache/pip"
export TMPDIR="$PATHVLM_WORKSPACE_ROOT/tmp"

# Use the standard Hub HTTP transport unless a later documented audit changes this.
export HF_HUB_DISABLE_XET=1
export HF_HUB_DOWNLOAD_TIMEOUT=120

